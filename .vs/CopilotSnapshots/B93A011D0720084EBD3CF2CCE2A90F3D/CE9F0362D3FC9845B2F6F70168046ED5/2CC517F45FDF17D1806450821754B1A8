    ajouterEnseignant(data) {
      const newEnseignant = {
        id: this.enseignants.length + 1,
        ...data,
        nbHeures: 0,
        matieres: data.matieres || [],
        dateRecrutement: new Date().toISOString().split('T')[0]
      };
      this.enseignants.unshift(newEnseignant);
    },

    modifierEnseignant(id, data) {
      const index = this.enseignants.findIndex(e => e.id === id);
      if (index !== -1) {
        this.enseignants[index] = { ...this.enseignants[index], ...data };
      }
    },

    supprimerEnseignant(id) {
      this.enseignants = this.enseignants.filter(e => e.id !== id);
    },

    setFiltre(key, value) {
      this.filtres[key] = value;
    },

    resetFiltres() {
      this.filtres = {
        search: '',
        specialite: 'Toutes',
        statut: 'Tous'
      };
    },

